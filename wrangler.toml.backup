name = "malta-osint"
main = ".open-next/worker.js"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

[vars]
NEXT_PUBLIC_MAP_CENTER_LAT = "35.9375"
NEXT_PUBLIC_MAP_CENTER_LNG = "14.3754"
NEXT_PUBLIC_MAP_ZOOM = "9"
NEXT_PUBLIC_DEFAULT_LAYERS = "maritime,aviation,weather,earthquakes,news"

[assets]
directory = ".open-next/assets"
